{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifang Companion",
  "version": "0.3.1",
  "identifier": "com.bifang.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1435",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Bifang Companion", "width": 390, "height": 844, "minWidth": 320, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "icon": ["../../desktop/src-tauri/icons/32x32.png", "../../desktop/src-tauri/icons/128x128.png", "../../desktop/src-tauri/icons/128x128@2x.png", "../../desktop/src-tauri/icons/icon.icns", "../../desktop/src-tauri/icons/icon.ico"]
  }
}
