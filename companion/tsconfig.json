{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "skipLibCheck": true,
    "jsx": "react-jsx", "strict": true, "noEmit": true, "isolatedModules": true,
    "resolveJsonModule": true, "esModuleInterop": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
