# Bifang Configuration
# =====================

# Default provider (nvidia, nebius, openai, anthropic, openrouter)
BIFANG_DEFAULT_PROVIDER=nebius

# Separate remote-review development service; not the desktop server.
# Configure independently provisioned client token hashes, never provider keys.
# BIFANG_REMOTE_CLIENTS=[{"subject":"owner-id","token_sha256":"<sha256-of-client-token>"}]
# BIFANG_REMOTE_STATE=/absolute/private/persistent-directory
# BIFANG_REMOTE_HOST=127.0.0.1
BIFANG_REMOTE_AUTHENTICATORS={}

# NVIDIA direct API (Nemotron models via NVIDIA Inference API)
# For NVIDIA NIM, set this base URL to the OpenAI-compatible NIM endpoint
# and set NVIDIA_API_KEY as required by that NIM deployment.
# NVIDIA_API_KEY=
# BIFANG_NVIDIA_BASE_URL=http://localhost:8000/v1
# BIFANG_NVIDIA_MODEL=<model-served-by-nim>
# Optional exact image-capable NIM model IDs, also checked against live /models.
# BIFANG_VISION_MODELS={"nvidia":["<image-capable-model-served-by-nim>"]}

# Nebius Token Factory (Nemotron models via Nebius)
NEBIUS_API_KEY=
BIFANG_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
BIFANG_NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# OpenAI
# OPENAI_API_KEY=
# BIFANG_OPENAI_BASE_URL=https://api.openai.com/v1
# BIFANG_OPENAI_MODEL=openai/gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=
# BIFANG_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# BIFANG_ANTHROPIC_MODEL=anthropic/claude-3-5-sonnet-20241022

# OpenRouter (access to many models)
# OPENROUTER_API_KEY=
# BIFANG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# BIFANG_OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Agent behavior
BIFANG_ROUTING_MODE=pinned
# Set auto for verified Token Factory task-based model selection.
# BIFANG_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# BIFANG_BALANCED_MODEL=nvidia/nemotron-3-super-120b-a12b
# BIFANG_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
BIFANG_MODE=assist
BIFANG_APPROVAL_MODE=manual
BIFANG_MAX_STEPS=12
BIFANG_TIMEOUT=180
BIFANG_WORKTREE=1
BIFANG_BWRAP=1

# Approved web searches send the query to Tavily; keep this key outside Git.
# TAVILY_API_KEY=

# Context efficiency
BIFANG_MAX_CONTEXT_TOKENS=100000
BIFANG_ENABLE_SUMMARIZATION=1
BIFANG_SUMMARIZATION_THRESHOLD=0.8

# Persistent memory
BIFANG_ENABLE_MEMORY=1
# BIFANG_MEMORY_DB_PATH=~/.local/state/bifang/memory.db
# Local full-text retrieval is the default. Opt in to remote embeddings below.
# BIFANG_MEMORY_EMBEDDING_PROVIDER=nebius
# BIFANG_MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Conversation transcripts are separate from project facts and model KV tensors.
BIFANG_ENABLE_CONVERSATION_HISTORY=1
# BIFANG_CONVERSATION_CACHE_PATH=~/.local/state/bifang/conversations/custom

# Arize Phoenix tracing (install with: pip install -e '.[observability]')
BIFANG_ENABLE_TRACING=0
BIFANG_TRACING_BACKEND=phoenix
# BIFANG_TRACING_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=
# Set BIFANG_TRACING_BACKEND=langsmith for metadata-only LangSmith export.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=bifang
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# MCP Servers (JSON array)
# BIFANG_MCP_SERVERS=[{"name": "filesystem", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/dir"]}]
